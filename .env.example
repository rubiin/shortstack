# Shortstack local configuration. Copy to .env and change secrets before deployment.
NODE_ENV=development

# App + branded links
APP_ORIGIN=http://localhost:3000
SHORT_LINK_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-at-least-32-random-characters
FILE_SIGNING_SECRET=change-me-to-at-least-32-random-characters

# Storage
DATABASE_PATH=./data/shortstack.db
FILE_STORAGE_DIR=./storage
EXPORT_RETENTION_DAYS=7
RAW_IMPORT_RETENTION_DAYS=7
CLICK_RETENTION_MONTHS=24

# Seeded demo data
SEED_PASSWORD=shortstack-demo
SEED_WORKSPACE_TIMEZONE=UTC

# Cloudflare cache purge adapter (optional). Redirects are no-store, so purge is
# a safety net for deployments that deliberately enable shared caching.
CLOUDFLARE_PURGE_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
CLOUDFLARE_TIMEOUT_MS=4000

# Worker
WORKER_POLL_MS=1000
WORKER_ID=shortstack-worker
LOG_LEVEL=info
